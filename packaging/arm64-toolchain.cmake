set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
if(NOT DEFINED MUOS_CC OR NOT DEFINED MUOS_SYSROOT)
  message(FATAL_ERROR "Pass -DMUOS_CC=... and -DMUOS_SYSROOT=...")
endif()
set(CMAKE_C_COMPILER "${MUOS_CC}")
set(CMAKE_SYSROOT "${MUOS_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH "${MUOS_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_C_FLAGS_INIT "-mcpu=cortex-a53")
